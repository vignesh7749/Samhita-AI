# SAMHITA AI Configuration

# Database: Uses SQLite by default for zero-setup out-of-the-box demo execution.
# For PostgreSQL enterprise deployment, set:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/samhita_ai
DATABASE_URL=sqlite:///./samhita.db

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Security & CORS
SECRET_KEY=samhita-ai-secret-key-for-sih-2026-production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: External LLM API key if enabled in future iterations
# OPENAI_API_KEY=
# GEMINI_API_KEY=
